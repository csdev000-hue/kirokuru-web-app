{
  "name": "kirokuru-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest tests/unit",
    "test:run": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "NODE_ENV=test tsx tests/helpers/run-e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:security": "vitest run tests/security",
    "test:s3": "vitest run tests/integration/s3.test.ts",
    "test:livekit": "vitest run tests/integration/livekit-provider.test.ts",
    "security:secrets": "tsx scripts/security-check.ts",
    "security:client": "tsx scripts/verify-client-secrets.ts",
    "security:readiness": "tsx scripts/production-readiness.ts",
    "infra:build": "tsc -p infra/aws/tsconfig.json",
    "infra:synth": "tsx infra/aws/synth.ts",
    "infra:synth:fixture": "tsx infra/aws/synth.ts --fixture",
    "test:infra": "vitest run tests/infrastructure",
    "budget:check": "tsx scripts/budget-check.ts",
    "infra:guard": "tsx scripts/nonprod-guard.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@next/env": "^16.3.5",
    "@vercel/oidc-aws-credentials-provider": "^3.3.8",
    "drizzle-orm": "^0.45.2",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "next": "^16.3.5",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
