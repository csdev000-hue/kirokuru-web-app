{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Principal": {"Federated": "arn:aws:iam::REPLACE_NONPROD_ACCOUNT:oidc-provider/oidc.vercel.com/REPLACE_TEAM_SLUG"},
    "Action": "sts:AssumeRoleWithWebIdentity",
    "Condition": {"StringEquals": {
      "oidc.vercel.com/REPLACE_TEAM_SLUG:aud": "https://vercel.com/REPLACE_TEAM_SLUG",
      "oidc.vercel.com/REPLACE_TEAM_SLUG:sub": [
        "owner:REPLACE_TEAM_SLUG:project:REPLACE_PROJECT_NAME:environment:development",
        "owner:REPLACE_TEAM_SLUG:project:REPLACE_PROJECT_NAME:environment:preview"
      ]
    }}
  }]
}
