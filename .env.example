# 開発用の設定のみを .env.local に記載してください。実値・Secretのコミットは禁止です。
DATABASE_URL=

AUTH_SECRET=
AUTH_TRUST_HOST=

AWS_REGION=
# IAM Role等の標準Credential Providerを使う場合、以下2項目は空欄で構いません。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_MODEL_ID=

S3_BUCKET_NAME=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

NEXT_PUBLIC_APP_URL=

# Google OAuth。公開変数にはしないでください。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 公開アプリの信頼できるURL（例: 開発環境のURL）。本番はHTTPS。
AUTH_URL=

# Phase 6: modelの上限に合わせて設定する保守的な入力上限（bytes）。
AI_MINUTES_MAX_INPUT_BYTES=60000
AI_MINUTES_MAX_OUTPUT_TOKENS=4096
AI_MINUTES_TIMEOUT_MS=30000

# Phase 9: server-only recording limits; per-environment private S3 bucket above.
MAX_RECORDING_FILE_SIZE_BYTES=524288000
RECORDING_UPLOAD_URL_TTL_SECONDS=600
RECORDING_DOWNLOAD_URL_TTL_SECONDS=300

# Phase 10: enable only with environment-specific LiveKit configuration above.
LIVE_MEETING_ENABLED=false
LIVEKIT_TOKEN_TTL_SECONDS=1800
# MVP small-team meeting capacity; adjust after load testing.
LIVEKIT_MAX_PARTICIPANTS=20

# Phase 11: server-side kill switches (cleanup DELETE/end/leave remains available).
AI_ENABLED=true
RECORDING_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=300
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_AI_PROJECT_PER_MINUTE=30
RATE_LIMIT_AI_RESOURCE_PER_MINUTE=5
RATE_LIMIT_TOKEN_PER_MINUTE=30
RATE_LIMIT_PRESIGNED_URL_PER_MINUTE=30
RATE_LIMIT_REGISTRATION_PER_MINUTE=30

# Infra-Verify: nonproduction Vercel OIDC only; never set long-lived AWS keys on Vercel.
# Verify account ownership and Trust before configuring Development/Preview scopes.
AWS_NONPROD_ACCOUNT_ID=
AWS_ROLE_ARN=
# Explicit AWS_REGION above is mandatory. VERCEL/VERCEL_ENV are platform-supplied.
# Local offline tooling paths; do not place secrets in configuration JSON.
NONPROD_CONFIG_FILE=
NONPROD_APPROVAL_FILE=
CLOUD_APPLY_ALLOWED=false
BUDGET_USAGE_FILE=
