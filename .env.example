# 開発用の設定のみを .env.local に記載してください。実値・Secretのコミットは禁止です。
DATABASE_URL=

AUTH_SECRET=
AUTH_TRUST_HOST=

AWS_REGION=
# IAM Role等の標準Credential Providerを使う場合、以下2項目は空欄で構いません。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_MODEL_ID=

S3_BUCKET_NAME=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

NEXT_PUBLIC_APP_URL=

# Google OAuth。公開変数にはしないでください。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 公開アプリの信頼できるURL（例: 開発環境のURL）。本番はHTTPS。
AUTH_URL=

# Phase 6: modelの上限に合わせて設定する保守的な入力上限（bytes）。
AI_MINUTES_MAX_INPUT_BYTES=60000
AI_MINUTES_MAX_OUTPUT_TOKENS=4096
AI_MINUTES_TIMEOUT_MS=30000

# Phase 9: server-only recording limits; per-environment private S3 bucket above.
MAX_RECORDING_FILE_SIZE_BYTES=524288000
RECORDING_UPLOAD_URL_TTL_SECONDS=600
RECORDING_DOWNLOAD_URL_TTL_SECONDS=300
