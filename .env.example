# 開発用の設定のみを .env.local に記載してください。実値・Secretのコミットは禁止です。
DATABASE_URL=

AUTH_SECRET=
AUTH_TRUST_HOST=

AWS_REGION=
# IAM Role等の標準Credential Providerを使う場合、以下2項目は空欄で構いません。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_MODEL_ID=

S3_BUCKET_NAME=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

NEXT_PUBLIC_APP_URL=

# Google OAuth。公開変数にはしないでください。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 公開アプリの信頼できるURL（例: 開発環境のURL）。本番はHTTPS。
AUTH_URL=
